{
  "name": "berkshire-safety-consultants",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:baseline": "tsx scripts/verify-baseline.ts",
    "migrate:posts": "tsx --env-file=.env.local scripts/migrate-posts.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/image-url": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.4.3",
    "next-sanity": "^13.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^17.3.0",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
